{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": { "libs/*": ["libs/*"], "components/*": ["components/*"] },
    "types": ["astro/client", "vite/client", "node", "vitest/globals"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "storybook-static",
    "cypress",
    "cypress.config.ts",
    "graphify-out"
  ]
}
